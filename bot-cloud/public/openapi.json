{
  "openapi": "3.0.0",
  "info": {
    "title": "Tattoo Hub Ops Cloud API",
    "version": "1.0.0",
    "description": "API Serverless para el Bot de Discord, Gestión de Incidentes Sentry, Autenticación 2FA y Operaciones de Tattoo Hub. Importable en Postman mediante URL directa."
  },
  "servers": [
    {
      "url": "https://tattoo-hub-ops.vercel.app",
      "description": "Servidor de Producción Vercel"
    },
    {
      "url": "http://localhost:3100",
      "description": "Servidor de Desarrollo Local"
    }
  ],
  "paths": {
    "/api/interactions": {
      "post": {
        "summary": "Discord HTTP Interactions Endpoint",
        "description": "Punto de enlace para recibir PINGs y Slash Commands desde Discord Developer Portal con verificación ed25519.",
        "parameters": [
          {
            "name": "X-Signature-Ed25519",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Firma criptográfica ed25519 calculada por Discord"
          },
          {
            "name": "X-Signature-Timestamp",
            "in": "header",
            "required": true,
            "schema": { "type": "string" },
            "description": "Marca temporal enviada por Discord"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": { "type": "integer", "example": 1, "description": "1 = PING, 2 = APPLICATION_COMMAND" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "PONG o mensaje de respuesta para Discord",
            "content": {
              "application/json": {
                "schema": { "type": "object", "example": { "type": 1 } }
              }
            }
          },
          "401": { "description": "Firma inválida o faltante" }
        }
      }
    },
    "/api/sentry-webhook": {
      "post": {
        "summary": "Receptor de Alertas Sentry",
        "description": "Recibe webhooks de excepciones de Sentry, los almacena en Firebase Firestore y los publica en Discord (#errores) con @everyone.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "object",
                    "properties": {
                      "event_id": { "type": "string", "example": "sentry-123" },
                      "title": { "type": "string", "example": "Error de Conexión a Base de Datos" },
                      "message": { "type": "string", "example": "Timeout al conectar con el socket" },
                      "level": { "type": "string", "enum": ["info", "warning", "error", "fatal"], "example": "error" },
                      "environment": { "type": "string", "example": "staging" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Incidente registrado y notificado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": { "status": "OK", "recordedId": "sentry-123", "message": "Incidente procesado" }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth": {
      "post": {
        "summary": "Iniciar Sesión en el Panel Ops",
        "description": "Valida usuario, contraseña y código 2FA TOTP (si está activado). Retorna token de sesión.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "admin" },
                  "password": { "type": "string", "example": "admin123!" },
                  "twoFactorCode": { "type": "string", "example": "123456", "description": "Código de 6 dígitos si 2FA está activo" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada exitosamente o solicitud de código 2FA",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": { "success": true, "token": "session_token_123", "requires2FA": false }
                }
              }
            }
          },
          "401": { "description": "Credenciales inválidas o código 2FA erróneo" }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "summary": "Cambiar Contraseña de Administrador",
        "description": "Actualiza la contraseña del usuario en Firestore con un nuevo salt y hash SHA-256.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword"],
                "properties": {
                  "username": { "type": "string", "example": "admin" },
                  "currentPassword": { "type": "string", "example": "admin123!" },
                  "newPassword": { "type": "string", "example": "nuevaClaveSegura2026!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña actualizada exitosamente",
            "content": {
              "application/json": {
                "schema": { "type": "object", "example": { "success": true, "message": "Contraseña actualizada" } }
              }
            }
          },
          "401": { "description": "Contraseña actual incorrecta" }
        }
      }
    },
    "/api/auth/2fa": {
      "get": {
        "summary": "Consultar Estado de 2FA",
        "description": "Retorna si el usuario tiene activado 2FA.",
        "parameters": [
          { "name": "username", "in": "query", "schema": { "type": "string", "default": "admin" } }
        ],
        "responses": {
          "200": {
            "description": "Estado de 2FA",
            "content": {
              "application/json": {
                "schema": { "type": "object", "example": { "twoFactorEnabled": false } }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Gestionar Configuración de 2FA",
        "description": "Permite generar clave QR (setup), verificar y activar (verify_and_enable), o desactivar (disable).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": { "type": "string", "enum": ["setup", "verify_and_enable", "disable"], "example": "setup" },
                  "username": { "type": "string", "example": "admin" },
                  "secret": { "type": "string", "example": "JBSWY3DPEHPK3PXP" },
                  "code": { "type": "string", "example": "123456" },
                  "password": { "type": "string", "example": "admin123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado de la acción 2FA",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": { "secret": "JBSWY...", "qrCode": "data:image/png;base64,..." }
                }
              }
            }
          }
        }
      }
    },
    "/api/data": {
      "get": {
        "summary": "Obtener Datos y Telemetría en Vivo",
        "description": "Retorna las incidencias de Sentry, comandos ejecutados de Discord y cola de tareas de Firestore.",
        "responses": {
          "200": {
            "description": "Datos en tiempo real de Firestore",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "success": true,
                    "incidents": [],
                    "commands": [],
                    "tasks": []
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/discord/send": {
      "post": {
        "summary": "Enviar Mensaje o Alerta a Discord",
        "description": "Publica comunicados, anuncios o embeds en los canales oficiales de Discord de Tattoo Hub desde la web.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "channel": { "type": "string", "example": "alertas" },
                  "title": { "type": "string", "example": "Actualización de Sprint" },
                  "message": { "type": "string", "example": "Sprint 7 completado al 100%." },
                  "mentionEveryone": { "type": "boolean", "example": false },
                  "color": { "type": "string", "example": "#f59e0b" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mensaje publicado en Discord",
            "content": {
              "application/json": {
                "schema": { "type": "object", "example": { "success": true, "message": "Mensaje despachado" } }
              }
            }
          }
        }
      }
    }
  }
}
