{
  "name": "tattoo-shop-v2-e2e",
  "version": "2.0.0",
  "description": "Comprehensive 4-tier requirement-driven E2E test suite for Tattoo Shop V2",
  "type": "module",
  "main": "run_tests.ts",
  "scripts": {
    "test": "npx tsx run_tests.ts",
    "test:tsx": "npx tsx run_tests.ts",
    "test:tier1": "npx tsx run_tests.ts --tier 1",
    "test:tier2": "npx tsx run_tests.ts --tier 2",
    "test:tier3": "npx tsx run_tests.ts --tier 3",
    "test:tier4": "npx tsx run_tests.ts --tier 4",
    "test:dom": "npx tsx run_tests.ts --dom-only",
    "test:build": "npx tsx run_tests.ts --build-only",
    "test:json": "npx tsx run_tests.ts --json",
    "test:list": "npx tsx run_tests.ts --list",
    "test:playwright": "npx playwright test",
    "test:playwright:ci": "npx playwright test --reporter=list",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "e2e",
    "testing",
    "tattoo-shop",
    "integration",
    "opaque-box"
  ],
  "author": "testwriter_e2e",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
